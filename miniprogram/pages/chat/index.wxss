.screen {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #171113;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 28rpx) 34rpx 20rpx;
  border-bottom: 1rpx solid rgba(234, 184, 137, 0.18);
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  display: grid;
  width: 62rpx;
  height: 62rpx;
  place-items: center;
  border: 2rpx solid #e5a16e;
  border-radius: 50%;
  color: #e5a16e;
  font-size: 31rpx;
  font-weight: 700;
}

.brand-overline,
.brand-name {
  display: block;
}

.brand-overline {
  color: #9d827a;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.brand-name {
  margin-top: 4rpx;
  color: #f7e4d5;
  font-size: 31rpx;
  font-weight: 600;
}

.account-entry {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border: 1rpx solid rgba(234, 184, 137, 0.3);
  border-radius: 50%;
  background: transparent;
  color: #e5a16e;
  line-height: 64rpx;
}

.account-glyph {
  font-size: 26rpx;
}

.state-panel {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 18rpx;
  padding: 80rpx;
  text-align: center;
}

.state-title {
  color: #f5e9e0;
  font-size: 34rpx;
}

.state-copy {
  color: #a8938d;
  font-size: 25rpx;
  line-height: 1.7;
}

.warning-panel {
  background: linear-gradient(180deg, #171113 0%, #211617 100%);
}

.presence-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 34rpx;
  color: #bdaaa1;
  font-size: 22rpx;
}

.presence-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #78b69a;
  box-shadow: 0 0 16rpx #78b69a;
}

.presence-separator {
  color: #765e5a;
}

.conversation {
  flex: 1;
  min-height: 0;
}

.conversation-inner {
  min-height: 100%;
  padding: 10rpx 34rpx 34rpx;
}

.scene-note {
  margin: 20rpx 0 42rpx;
  color: #907773;
  font-size: 21rpx;
  text-align: center;
}

.message-row {
  position: relative;
  max-width: 84%;
  margin: 0 0 34rpx;
}

.message-row.user {
  margin-left: auto;
}

.message-author {
  display: block;
  margin: 0 0 10rpx;
  color: #aa8f86;
  font-size: 20rpx;
}

.user .message-author {
  text-align: right;
}

.message-copy {
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(234, 184, 137, 0.18);
  border-radius: 8rpx;
  background: #201618;
  color: #f7ebe4;
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-word;
}

.user .message-copy {
  border-color: rgba(121, 181, 155, 0.28);
  background: #17221f;
}

.reply-record {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin: 14rpx 0 0;
  padding: 0;
  border-radius: 50%;
  background: #b96d4f;
}

.record-ring {
  width: 22rpx;
  height: 22rpx;
  border: 5rpx solid #261516;
  border-radius: 50%;
}

.reply-record.is-playing {
  animation: spin 1.2s linear infinite;
}

.thinking-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0 28rpx;
  color: #b69f98;
  font-size: 23rpx;
}

.thinking-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e5a16e;
  animation: pulse 1.2s ease-in-out infinite;
}

.composer-wrap {
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  border-top: 1rpx solid rgba(234, 184, 137, 0.16);
  background: #191214;
}

.composer {
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(234, 184, 137, 0.25);
  border-radius: 8rpx;
  background: #211719;
}

.composer-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 60rpx;
  max-height: 200rpx;
  color: #f5e9e0;
  font-size: 29rpx;
  line-height: 1.45;
}

.composer-placeholder {
  color: #7f6c68;
}

.composer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.hold-record,
.text-action {
  padding: 10rpx 4rpx;
  background: transparent;
  color: #d4b097;
  font-size: 23rpx;
  line-height: 1.4;
}

.hold-record.is-recording {
  color: #ec8465;
}

.send-button {
  min-width: 112rpx;
  padding: 14rpx 22rpx;
  border-radius: 6rpx;
  background: #b96d4f;
  color: #fff7f1;
  font-size: 25rpx;
  line-height: 1.3;
}

.send-button[disabled],
.hold-record[disabled] {
  opacity: 0.45;
}

.signin-gate {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 12rpx;
  color: #c8b3a8;
  font-size: 25rpx;
}

@keyframes pulse {
  50% { opacity: 0.35; transform: scale(0.7); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
