.screen {
  min-height: 100vh;
  background: #171113;
}

.topbar {
  padding: calc(env(safe-area-inset-top) + 34rpx) 34rpx 24rpx;
  border-bottom: 1rpx solid rgba(234, 184, 137, 0.18);
}

.brand-kicker,
.brand-title {
  display: block;
}

.brand-kicker {
  color: #9d827a;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.brand-title {
  margin-top: 7rpx;
  color: #f7e4d5;
  font-size: 40rpx;
  font-weight: 600;
}

.state-block {
  display: flex;
  min-height: 62vh;
  padding: 40rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 22rpx;
  color: #cbb8ae;
  text-align: center;
}

.state-title {
  color: #f4e3d8;
  font-size: 34rpx;
}

.state-copy {
  color: #a8938d;
  font-size: 25rpx;
  line-height: 1.7;
}

.primary-action {
  margin-top: 18rpx;
  padding: 17rpx 30rpx;
  border-radius: 6rpx;
  background: #b96d4f;
  color: #fff7f1;
  font-size: 26rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 44rpx 34rpx 38rpx;
}

.profile-seal {
  display: grid;
  width: 96rpx;
  height: 96rpx;
  place-items: center;
  border: 2rpx solid #e5a16e;
  border-radius: 50%;
  color: #f5dfcf;
  font-size: 40rpx;
}

.profile-name,
.profile-email {
  display: block;
}

.profile-name {
  color: #f5e9e0;
  font-size: 36rpx;
  font-weight: 600;
}

.profile-email {
  margin-top: 10rpx;
  color: #9d827a;
  font-size: 23rpx;
}

.section-switch {
  display: flex;
  gap: 28rpx;
  padding: 0 34rpx;
  border-bottom: 1rpx solid rgba(234, 184, 137, 0.16);
}

.switch-item {
  margin: 0;
  padding: 16rpx 4rpx;
  border-radius: 0;
  background: transparent;
  color: #9e8881;
  font-size: 26rpx;
  line-height: 1.4;
}

.switch-item.active {
  border-bottom: 3rpx solid #e5a16e;
  color: #f5e9e0;
}

.content-view {
  padding: 22rpx 34rpx calc(env(safe-area-inset-bottom) + 42rpx);
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(234, 184, 137, 0.11);
  color: #a99088;
  font-size: 26rpx;
}

.detail-value {
  max-width: 55%;
  color: #eeded3;
  text-align: right;
}

.logout-action {
  margin: 38rpx 0 0;
  padding: 15rpx 6rpx;
  background: transparent;
  color: #d88769;
  font-size: 25rpx;
}

.memory-state {
  padding: 80rpx 0;
  color: #9f8982;
  font-size: 26rpx;
  text-align: center;
}

.memory-entry {
  padding: 27rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(234, 184, 137, 0.14);
}

.memory-meta {
  display: flex;
  justify-content: space-between;
  color: #a68c83;
  font-size: 21rpx;
}

.memory-copy {
  display: block;
  margin: 15rpx 0 9rpx;
  color: #f1e3da;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-word;
}

.delete-action {
  margin: 0;
  padding: 10rpx 0;
  background: transparent;
  color: #ca7d66;
  font-size: 22rpx;
}
