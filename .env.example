# HutaoChatCore local configuration template
#
# 1. Copy this file to .env and edit the copy.
# 2. Keep every password and API key empty in this template.
# 3. Never commit .env, runtime.env, database dumps, user data, or model weights.
# 4. The defaults below bind the service to loopback and keep optional features off.

# =============================================================================
# Core runtime
# =============================================================================
APP_NAME=HutaoChatCore
ENVIRONMENT=local
HOST=127.0.0.1
PORT=8000

# Supported values: jsonl, postgresql. MySQL is not a STORAGE_BACKEND value;
# it is enabled separately by DATABASE_V2_ENABLED for identity/control data.
STORAGE_BACKEND=jsonl
JSONL_STORAGE_DIR=./logs/storage
PERSONA_PROFILE=hutao_v1

# =============================================================================
# Text model and response latency
# =============================================================================
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-pro
MODEL_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
API_TEMPERATURE=0.8
API_TIMEOUT_SECONDS=90

# Only DeepSeek is registered as a production text provider in the current
# runtime. Retry/circuit settings still fail closed when it is unavailable.
TEXT_PROVIDER_ORDER=deepseek
TEXT_PROVIDER_RETRIES=0
TEXT_STREAM_TTFT_TIMEOUT_SECONDS=20
TEXT_STREAM_TOTAL_BUDGET_SECONDS=90
TEXT_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
TEXT_PROVIDER_CIRCUIT_RECOVERY_SECONDS=60

# Conversation context window sent to the model. Long-term memory is managed
# separately by the repository and semantic-memory settings below.
RECENT_CONTEXT_MAX_MESSAGES=8
RECENT_CONTEXT_MAX_CHARS=80

# =============================================================================
# PostgreSQL Web core
# =============================================================================
# To use PostgreSQL for chat, memory, and optionally Web accounts:
#   STORAGE_BACKEND=postgresql
# Then create the database and run:
#   python scripts/apply_postgres_web_migrations.py
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# MySQL Database V2 (optional identity/control plane)
# =============================================================================
# Keep STORAGE_BACKEND=jsonl or postgresql. When both PostgreSQL and MySQL V2
# are ready, PostgreSQL stores chat data and MySQL V2 owns Web identities.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
DATABASE_V2_ENABLED=false

# These write paths require Database V2 and its migrations. Enable one step at
# a time only after readiness checks and backups pass.
KNOWLEDGE_CANDIDATE_INTAKE_ENABLED=false
PERSONA_MANAGEMENT_PERSISTENCE_ENABLED=false
PERSONA_MANAGEMENT_WRITES_ENABLED=false

# =============================================================================
# Web accounts and owner control plane
# =============================================================================
# Authentication requires either a configured PostgreSQL backend or MySQL V2.
# Registration and password reset additionally require the SMTP section.
PUBLIC_WEB_AUTH_ENABLED=false
PUBLIC_WEB_SESSION_LIFETIME_SECONDS=604800
# false is for local HTTP only; use true behind correctly configured HTTPS.
SESSION_COOKIE_SECURE=false

# Comma-separated account emails allowed to enter /control. Empty means no Web
# account is an administrator after Web auth is enabled. With auth disabled,
# /control remains a loopback-only local development surface.
CONTROL_ADMIN_EMAILS=
CONTROL_LOCAL_ONLY=true

# =============================================================================
# SMTP email verification and password reset
# =============================================================================
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true

# =============================================================================
# Semantic memory (optional derived index)
# =============================================================================
# The SQL/JSONL repository remains authoritative. Qdrant contains rebuildable
# vector index data only.
SEMANTIC_MEMORY_ENABLED=false
SEMANTIC_MEMORY_QDRANT_URL=
SEMANTIC_MEMORY_QDRANT_API_KEY=
SEMANTIC_MEMORY_QDRANT_COLLECTION=hutao_memories

# Preferred offline setup: point to an already downloaded local model folder.
SEMANTIC_MEMORY_EMBEDDING_PROVIDER=local_sentence_transformer
SEMANTIC_MEMORY_EMBEDDING_MODEL_PATH=
SEMANTIC_MEMORY_EMBEDDING_DEVICE=cpu
SEMANTIC_MEMORY_EMBEDDING_MAX_LENGTH=8192

# Used only when SEMANTIC_MEMORY_EMBEDDING_PROVIDER=openai_compatible.
SEMANTIC_MEMORY_EMBEDDING_BASE_URL=
SEMANTIC_MEMORY_EMBEDDING_API_KEY=
SEMANTIC_MEMORY_EMBEDDING_MODEL=
SEMANTIC_MEMORY_EMBEDDING_TIMEOUT_SECONDS=15
SEMANTIC_MEMORY_RETRIEVAL_LIMIT=8
SEMANTIC_MEMORY_MIN_SCORE=0.35

# =============================================================================
# Audio input: FunASR / SenseVoice and emotion2vec
# =============================================================================
ASR_FILE_PRESETS=sensevoice-small
ASR_REPAIR_PRESETS=
AUDIO_WARMUP_ENABLED=false
AUDIO_EMOTION_ENABLED=true
AUDIO_EMOTION_MODEL=iic/emotion2vec_plus_large
ASR_PROVIDER_TIMEOUT_SECONDS=180
ASR_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
ASR_PROVIDER_CIRCUIT_RECOVERY_SECONDS=60
VOICE_CHAT_REPLY_TIMEOUT_SECONDS=25

# Uploads are staged in the operating-system temp directory and removed after
# transcription/chat processing.
AUDIO_UPLOAD_MAX_BYTES=26214400
AUDIO_UPLOAD_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg,.webm
AUDIO_UPLOAD_ALLOWED_CONTENT_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp3,audio/mp4,audio/x-m4a,audio/flac,audio/ogg,audio/webm,audio/wave,audio/vnd.wave,video/webm,audio/x-matroska,application/ogg,application/octet-stream

# =============================================================================
# Web voice output: local GPT-SoVITS
# =============================================================================
# Requires PUBLIC_WEB_AUTH_ENABLED=true and a separately running local service.
PUBLIC_WEB_TTS_ENABLED=false
PUBLIC_WEB_TTS_PROVIDER=gpt_sovits
PUBLIC_WEB_TTS_BASE_URL=http://127.0.0.1:9880
PUBLIC_WEB_TTS_OUTPUT_DIR=data/generated_voice/web
PUBLIC_WEB_TTS_REPLY_TTL_SECONDS=300
PUBLIC_WEB_TTS_MIN_INTERVAL_SECONDS=8
PUBLIC_WEB_TTS_MAX_REPLY_CHARS=800
PUBLIC_WEB_TTS_TOTAL_BUDGET_SECONDS=120

# =============================================================================
# World tools (all disabled by default)
# =============================================================================
WORLD_AWARENESS_ENABLED=false
WORLD_FETCH_TIMEOUT_SECONDS=12
WORLD_FETCH_MAX_BYTES=1048576
WORLD_CACHE_MAX_ENTRIES=512
WORLD_MAX_CACHE_TTL_SECONDS=2592000
WORLD_OFFICIAL_SOURCE_MANIFEST=./data/world/sources.json
WORLD_SOURCE_ENABLED_IDS=
WORLD_SOURCE_LEGAL_APPROVED_IDS=

# Amap: weather, district, place, route, and consent-gated IP location.
AMAP_WEB_SERVICE_API_KEY=
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com
AMAP_ALLOWED_HOSTS=restapi.amap.com
AMAP_SOURCE_LEGAL_APPROVED=false
AMAP_IP_CACHE_TTL_SECONDS=86400
AMAP_WEATHER_CACHE_TTL_SECONDS=900
AMAP_DISTRICT_CACHE_TTL_SECONDS=2592000
AMAP_PLACE_CACHE_TTL_SECONDS=86400
AMAP_ROUTE_CACHE_TTL_SECONDS=300

# QWeather is an alternative weather adapter, not an automatic failover.
QWEATHER_API_KEY=
QWEATHER_API_BASE_URL=https://devapi.qweather.com
QWEATHER_ALLOWED_HOSTS=devapi.qweather.com
QWEATHER_SOURCE_LEGAL_APPROVED=false

# Real-time Web search. Results use a short in-memory cache and are not written
# into long-term facts or the world graph. Supported providers: tavily and
# duckduckgo; DuckDuckGo additionally requires the optional ddgs package.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_CACHE_TTL_SECONDS=300
