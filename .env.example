# HutaoChatCore current Web client template
# Copy this file to .env. Fill secrets only on the machine that runs Core.
# Do not commit .env or give its contents to ordinary users.

# =============================================================================
# Runtime and HeadCore
# =============================================================================
ENVIRONMENT=local
STORAGE_BACKEND=jsonl
# For PostgreSQL persistence, replace the preceding value with:
# STORAGE_BACKEND=postgresql
JSONL_STORAGE_DIR=./logs/storage
PERSONA_PROFILE=hutao_v1

# =============================================================================
# Chat model
# =============================================================================
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-pro
MODEL_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
API_TEMPERATURE=0.8
API_TIMEOUT_SECONDS=90
VOICE_CHAT_REPLY_TIMEOUT_SECONDS=25
TEXT_PROVIDER_ORDER=deepseek
TEXT_PROVIDER_RETRIES=0
TEXT_STREAM_TTFT_TIMEOUT_SECONDS=20
TEXT_STREAM_TOTAL_BUDGET_SECONDS=90
RECENT_CONTEXT_MAX_MESSAGES=8
RECENT_CONTEXT_MAX_CHARS=80
TEXT_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
TEXT_PROVIDER_CIRCUIT_RECOVERY_SECONDS=60

# =============================================================================
# MySQL and public Web accounts
# Set STORAGE_BACKEND=mysql and DATABASE_V2_ENABLED=true only after MySQL is ready.
# Use HTTPS before turning SESSION_COOKIE_SECURE and public registration on.
# =============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
DATABASE_V2_ENABLED=false

# Optional derived semantic-memory index. MySQL remains the only authoritative
# memory store. Qdrant contains only rebuildable vector index data.
SEMANTIC_MEMORY_ENABLED=false
SEMANTIC_MEMORY_QDRANT_URL=
SEMANTIC_MEMORY_QDRANT_API_KEY=
SEMANTIC_MEMORY_QDRANT_COLLECTION=hutao_memories
# Use a pre-downloaded local Sentence-Transformers model by default. This path
# must be a local model directory; the runtime does not download model weights.
SEMANTIC_MEMORY_EMBEDDING_PROVIDER=local_sentence_transformer
SEMANTIC_MEMORY_EMBEDDING_MODEL_PATH=
SEMANTIC_MEMORY_EMBEDDING_DEVICE=cpu
SEMANTIC_MEMORY_EMBEDDING_MAX_LENGTH=8192
# Set SEMANTIC_MEMORY_EMBEDDING_PROVIDER=openai_compatible before using these.
SEMANTIC_MEMORY_EMBEDDING_BASE_URL=
SEMANTIC_MEMORY_EMBEDDING_API_KEY=
SEMANTIC_MEMORY_EMBEDDING_MODEL=
SEMANTIC_MEMORY_EMBEDDING_TIMEOUT_SECONDS=15
SEMANTIC_MEMORY_RETRIEVAL_LIMIT=8
SEMANTIC_MEMORY_MIN_SCORE=0.35

# =============================================================================
# PostgreSQL Web core (recommended for new Web deployments)
# Create the target database first, then run scripts/apply_postgres_web_migrations.py.
# Keep DATABASE_V2_ENABLED=false when this PostgreSQL path is selected.
# =============================================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

PUBLIC_WEB_AUTH_ENABLED=false
SESSION_COOKIE_SECURE=false
PUBLIC_WEB_SESSION_LIFETIME_SECONDS=604800

# =============================================================================
# Email verification
# Keep disabled until the sender domain and SMTP provider have been verified.
# =============================================================================
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true

# =============================================================================
# Public Web Hu Tao voice playback
# Requires public Web authentication and a separately started local TTS service.
# Keep disabled until the local model has passed its listening acceptance test.
# =============================================================================
PUBLIC_WEB_TTS_ENABLED=false
PUBLIC_WEB_TTS_PROVIDER=gpt_sovits
PUBLIC_WEB_TTS_BASE_URL=http://127.0.0.1:9880
PUBLIC_WEB_TTS_OUTPUT_DIR=data/generated_voice/web
PUBLIC_WEB_TTS_REPLY_TTL_SECONDS=300
PUBLIC_WEB_TTS_MIN_INTERVAL_SECONDS=8
PUBLIC_WEB_TTS_MAX_REPLY_CHARS=800

# =============================================================================
# Audio input and local expression providers
# =============================================================================
ASR_FILE_PRESETS=sensevoice-small
ASR_REPAIR_PRESETS=
AUDIO_EMOTION_ENABLED=true
AUDIO_EMOTION_MODEL=iic/emotion2vec_plus_large
ASR_PROVIDER_TIMEOUT_SECONDS=180
ASR_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
ASR_PROVIDER_CIRCUIT_RECOVERY_SECONDS=60

# =============================================================================
# World tools
# All providers stay disabled until their terms have been reviewed.
# =============================================================================
WORLD_AWARENESS_ENABLED=false
WORLD_FETCH_TIMEOUT_SECONDS=12
WORLD_FETCH_MAX_BYTES=1048576
WORLD_CACHE_MAX_ENTRIES=512
WORLD_MAX_CACHE_TTL_SECONDS=2592000
WORLD_OFFICIAL_SOURCE_MANIFEST=./data/world/sources.json
WORLD_SOURCE_ENABLED_IDS=
WORLD_SOURCE_LEGAL_APPROVED_IDS=

AMAP_WEB_SERVICE_API_KEY=
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com
AMAP_ALLOWED_HOSTS=restapi.amap.com
AMAP_SOURCE_LEGAL_APPROVED=false
AMAP_IP_CACHE_TTL_SECONDS=86400
AMAP_WEATHER_CACHE_TTL_SECONDS=900
AMAP_DISTRICT_CACHE_TTL_SECONDS=2592000
AMAP_PLACE_CACHE_TTL_SECONDS=86400
AMAP_ROUTE_CACHE_TTL_SECONDS=300

QWEATHER_API_KEY=
QWEATHER_API_BASE_URL=https://devapi.qweather.com
QWEATHER_ALLOWED_HOSTS=devapi.qweather.com
QWEATHER_SOURCE_LEGAL_APPROVED=false
QWEATHER_WEATHER_CACHE_TTL_SECONDS=900

# =============================================================================
# Optional local camera perception
# No camera is opened, persisted, or uploaded by default.
# =============================================================================
CAMERA_PERCEPTION_ENABLED=false
CAMERA_LOCAL_CAPTURE_ENABLED=false
CAMERA_SESSION_MAX_SECONDS=300
CAMERA_OBSERVATION_TTL_SECONDS=15
CAMERA_RAW_FRAME_RETENTION_SECONDS=0
CAMERA_FACE_IDENTIFICATION_ENABLED=false
CAMERA_CLOUD_UPLOAD_ENABLED=false
CAMERA_CAPTURE_INTERVAL_SECONDS=2
CAMERA_TEMPORAL_CONFIRMATION_COUNT=2
CAMERA_TEMPORAL_WINDOW_SECONDS=8
CAMERA_MEDIAPIPE_ENABLED=true
CAMERA_YOLO_MODEL_PATH=

# =============================================================================
# Protected local visual workbench
# Keep disabled unless this machine has a unique administrator secret.
# The browser never receives this value. Use HTTPS before SESSION_COOKIE_SECURE=true.
# =============================================================================
VISUAL_WORKBENCH_ENABLED=false
VISUAL_WORKBENCH_ADMIN_SECRET=
VISUAL_WORKBENCH_SESSION_LIFETIME_SECONDS=1800
